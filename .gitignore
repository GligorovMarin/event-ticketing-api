# .gitignore: files git must NOT track (anything regenerable, and anything secret)

# ---- Build output (regenerated by Maven) ----
target/
*.class
*.jar
*.war

# ---- Environment files: they hold real secrets in real deployments ----
.env
.env.*

# ---- Logs ----
*.log

# ---- Editor and operating-system files ----
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
*.swp
.DS_Store

# ---- Personal notes that are not part of the project ----
MANUAL_CHECK.md
