<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml: the Maven build file. It answers "what does this project depend on, and how is it built?".

  Layout of this project (read these in order):
    docker-compose.yml      starts PostgreSQL and the API
    Dockerfile              builds the API image (dev / build / prod stages)
    src/main/resources/     application.yml (settings) and db/migration/ (Flyway SQL migrations)
    src/main/java/...       the application code
    src/test/java/...       unit tests (*Test) and integration tests (*IT)

  Everything runs inside Docker, so Java and Maven do not need to be installed locally.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Spring Boot "parent" supplies tested, compatible versions of ~hundreds of libraries, so
       the dependencies below need no version numbers of their own. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.portfolio</groupId>
  <artifactId>ticketing</artifactId>
  <version>0.1.0</version>
  <name>ticketing</name>
  <description>Event ticketing API with seat selection and timed seat holds</description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>3.2.0</springdoc.version>
  </properties>

  <dependencies>
    <!-- Web: REST controllers (Spring MVC) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Database access: Spring Data JPA (Hibernate) and the PostgreSQL driver -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Schema migrations: Flyway runs db/migration/V*.sql at startup, in version order -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Security: Spring Security, and JWT support (the "resource server" verifies bearer tokens) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Input validation (@NotBlank, @Size, ...) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Actuator: /actuator/health, used by Docker and monitoring -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Swagger UI (interactive API documentation) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Test dependencies: only on the test classpath, never shipped -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Packages the application as one runnable jar (used by the production Docker image) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Two kinds of tests, run by two plugins:
             *Test  -> unit tests, no Spring, no database      -> surefire plugin,  `mvn test`
             *IT    -> integration tests, real PostgreSQL      -> failsafe plugin,  `mvn verify`
           `mvn verify` runs both. The split keeps the fast tests fast. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
